{
  "name": "timetracker",
  "productName": "Timetracker",
  "version": "1.2.0",
  "description": "Time tracking per project with side widget, reports and CSV export.",
  "author": "BetterEdgeLLC",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "icons": "node scripts/build-icons.mjs",
