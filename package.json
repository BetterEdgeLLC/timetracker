    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "dist": "npm run build && electron-builder --win nsis",
    "readme-assets": "node scripts/readme-assets.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
